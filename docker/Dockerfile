FROM bellsoft/liberica-openjdk-alpine:21

# Устанавливает рабочую директорию внутри контейнера.
# Все последующие команды будут выполняться в папке /srv
# Если папка не существует — она создастся автоматически
WORKDIR /srv

# Копирует JAR-файл из вашей локальной папки в образ.
# target/*.jar — на вашей машине (где собирается проект) ищет все jar файлы в папке target
# . — копирует их в текущую рабочую директорию образа (/srv)
COPY target/*.jar .

#Скрипт
COPY docker/utils-service.sh .

# Устанавливаем bash, так как в alpine его нет по умолчанию
RUN apk add --no-cache bash

# Делаем скрипт запуска исполняемым
# Устанавливаем права на выполнение (execute permission) для скрипта
RUN chmod +x utils-service.sh

EXPOSE 8185

# При запуске контейнера будет выполнен этот скрипт
# Используется exec форма для лучшей обработки сигналов
ENTRYPOINT ["./utils-service.sh"]